# Database
DB_URL=mongodb://localhost:27017

# Server
PORT=8000
NODE_ENV=development
SERVER_TYPE=uvicorn

# Video Storage
# Set to "true" for local storage (static/media/), "false" for Cloudinary
USE_LOCAL_VIDEO_STORAGE=true

# Cloudinary (required when USE_LOCAL_VIDEO_STORAGE=false)
# Option A: Individual vars from https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Option B: Or use single CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Optional: folder in Cloudinary for videos (default: background_videos)
# CLOUDINARY_VIDEO_FOLDER=background_videos

# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Image Provider (pexels | replicate)
IMAGE_PROVIDER=pexels

# Pexels (when IMAGE_PROVIDER=pexels)
PEXELS_API_KEY=your_pexels_key

# Replicate (when IMAGE_PROVIDER=replicate)
REPLICATE_API_TOKEN=your_replicate_token
